{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Training session",
  "type": "object",
  "required": [
    "id",
    "title",
    "age_category",
    "duration_min",
    "primary_objective",
    "observable_behaviours",
    "players_range",
    "operational_contingencies",
    "duration_variant_60min",
    "equipment",
    "surface_plan",
    "segments",
    "message_foundations",
    "session_rationale",
    "match_theme",
    "reflection",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "age_category": {
      "const": "10–11 ani, grupe 2015 și 2016 tratate împreună"
    },
    "duration_min": {
      "enum": [
        60,
        75,
        90
      ]
    },
    "primary_objective": {
      "type": "string"
    },
    "observable_behaviours": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    },
    "players_range": {
      "type": "object"
    },
    "operational_contingencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenario", "guidance"],
        "properties": {
          "scenario": {"type": "string", "minLength": 1},
          "guidance": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "duration_variant_60min": {
      "type": "object",
      "required": ["total_minutes", "policy_note", "segments"],
      "properties": {
        "total_minutes": {"const": 60},
        "policy_note": {"type": "string", "minLength": 1},
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["segment_index", "start_min", "end_min", "reduction_note"],
            "properties": {
              "segment_index": {"type": "integer", "minimum": 0},
              "start_min": {"type": "integer", "minimum": 0},
              "end_min": {"type": "integer", "minimum": 0},
              "reduction_note": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "surface_plan": {
      "type": "object"
    },
    "segments": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "start_min",
          "end_min",
          "title",
          "exercise_ids",
          "coach_message",
          "why_now",
          "methodological_rationale",
          "observation_focus",
          "intervention_criteria",
          "transition_logistics"
        ],
        "properties": {
          "start_min": {
            "type": "integer"
          },
          "end_min": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "exercise_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coach_message": {
            "type": "string"
          },
          "why_now": {
            "type": "string"
          },
          "methodological_rationale": {
            "type": "string"
          },
          "observation_focus": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "intervention_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "transition_logistics": {
            "type": "string"
          },
          "non_intervention_criteria": {
            "type": "array",
            "items": {"type": "string"}
          },
          "coach_focus": {
            "type": "string"
          },
          "verification_method": {
            "type": "string"
          }
        }
      }
    },
    "message_foundations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    },
    "session_rationale": {
      "type": "string"
    },
    "match_theme": {
      "type": "string"
    },
    "reflection": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gold_standard_v2": {
      "type": "object",
      "required": ["status", "version"],
      "properties": {
        "status": {"enum": ["V1", "V2"]},
        "version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "child_objectives": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "coach_objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["objective", "coach_competency_id"],
        "properties": {
          "objective": {"type": "string", "minLength": 1},
          "coach_competency_id": {"type": "string", "pattern": "^COACH-C[0-9]{2}$"}
        },
        "additionalProperties": false
      }
    },
    "reflection_v2": {
      "type": "object",
      "required": ["child_game_dimension", "coach_dimension"],
      "properties": {
        "child_game_dimension": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "coach_dimension": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
