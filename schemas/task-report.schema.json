{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manual-u11.local/schemas/task-report.schema.json",
  "type": "object",
  "required": ["task_id", "verdict", "outputs", "validations", "limitations"],
  "properties": {
    "$schema": {"type": "string"},
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{4}$"},
    "verdict": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "validations": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
