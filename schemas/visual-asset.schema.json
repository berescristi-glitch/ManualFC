{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manual-u11.local/schemas/visual-asset.schema.json",
  "title": "Visual asset manifest",
  "type": "object",
  "required": ["id", "subject_id", "asset_type", "editable_source", "static_svg", "dimensions", "safety_margin_m", "attack_direction", "roles", "ball_start", "coach_position", "legend", "accessibility", "pdf_equivalent"],
  "properties": {
    "id": {"type": "string", "pattern": "^VIS-[0-9]{4,}$"},
    "subject_id": {"type": "string", "minLength": 1},
    "asset_type": {"enum": ["static", "dynamic"]},
    "media_type": {"enum": ["diagram", "animation", "photo", "illustration"]},
    "author": {"type": ["string", "null"]},
    "licence_source_id": {"type": ["string", "null"], "pattern": "^SRC-[0-9]{4,}$"},
    "editable_source": {"type": "string", "minLength": 1},
    "static_svg": {"type": "string", "minLength": 1},
    "dimensions": {
      "type": "object",
      "required": ["length_m", "width_m"],
      "properties": {
        "length_m": {"type": "number", "exclusiveMinimum": 0},
        "width_m": {"type": "number", "exclusiveMinimum": 0},
        "zones": {"type": "array"}
      }
    },
    "safety_margin_m": {"type": "number", "minimum": 0},
    "attack_direction": {"type": "string", "minLength": 1},
    "roles": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "ball_start": {"type": "string", "minLength": 1},
    "coach_position": {"type": "string", "minLength": 1},
    "legend": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "animation_data": {"type": ["string", "null"]},
    "states": {"type": "array", "items": {"type": "object"}},
    "accessibility": {
      "type": "object",
      "required": ["title", "description", "non_color_cues", "keyboard_controlled", "reduced_motion"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "non_color_cues": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "keyboard_controlled": {"type": "boolean"},
        "reduced_motion": {"type": "boolean"}
      }
    },
    "pdf_equivalent": {
      "type": "object",
      "required": ["frames", "equivalent_information"],
      "properties": {
        "frames": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string"}},
        "equivalent_information": {"const": true}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"media_type": {"const": "photo"}}, "required": ["media_type"]},
      "then": {
        "required": ["author", "licence_source_id"],
        "properties": {
          "author": {"type": "string", "minLength": 1},
          "licence_source_id": {"type": "string", "pattern": "^SRC-[0-9]{4,}$"}
        }
      }
    }
  ],
  "additionalProperties": false
}
