{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manual-u11.local/schemas/distribution-manifest.schema.json",
  "type": "object",
  "required": ["id", "version", "source_commit", "files", "clean_room_test"],
  "properties": {
    "$schema": {"type": "string"},
    "id": {"type": "string", "pattern": "^RELEASE-[0-9]{4,}$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "clean_room_test": {"const": true}
  },
  "additionalProperties": false
}
