{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manual-u11.local/schemas/curriculum.schema.json",
  "type": "object",
  "required": ["id", "title", "age_category", "blocks"],
  "properties": {
    "$schema": {"type": "string"},
    "id": {"type": "string", "pattern": "^CUR-[0-9]{4,}$"},
    "title": {"type": "string", "minLength": 3},
    "age_category": {"const": "10–11 ani, grupele 2015 și 2016 tratate împreună"},
    "blocks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "principle_ids", "session_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^BLK-[0-9]{4,}$"},
          "order": {"type": "integer", "minimum": 1},
          "principle_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "session_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
