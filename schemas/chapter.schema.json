{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manual-u11.local/schemas/chapter.schema.json",
  "type": "object",
  "required": ["id", "slug", "volume_id", "title", "principle_ids", "claim_ids"],
  "properties": {
    "$schema": {"type": "string"},
    "id": {"type": "string", "pattern": "^CH-[0-9]{4,}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "volume_id": {"type": "string", "pattern": "^VOLUME-(?:0[1-9]|10)$"},
    "title": {"type": "string", "minLength": 3},
    "principle_ids": {"type": "array", "items": {"type": "string", "pattern": "^(?:PRI|PR)-[0-9]{4,}$"}},
    "claim_ids": {"type": "array", "items": {"type": "string", "pattern": "^CLM-[0-9]{4,}$"}}
  },
  "additionalProperties": false
}
