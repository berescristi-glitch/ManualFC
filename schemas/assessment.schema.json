{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manual-u11.local/schemas/assessment.schema.json",
  "type": "object",
  "required": ["id", "title", "principle_ids", "criteria"],
  "properties": {
    "$schema": {"type": "string"},
    "id": {"type": "string", "pattern": "^ASM-[0-9]{4,}$"},
    "title": {"type": "string", "minLength": 3},
    "principle_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "observable_behaviour", "levels"],
        "properties": {
          "id": {"type": "string"},
          "observable_behaviour": {"type": "string", "minLength": 10},
          "levels": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 5}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
