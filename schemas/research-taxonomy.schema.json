{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manual-u11.local/schemas/research-taxonomy.schema.json",
  "type": "object",
  "required": ["schema_version", "source_types", "confidence_levels", "exclusion_reasons", "question_domains", "freshness_policies"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "source_types": {
      "type": "object", "minProperties": 18,
      "additionalProperties": {
        "type": "object",
        "required": ["authority", "allowed_uses", "limitations", "required_metadata", "recheck_policy", "citation_mode"],
        "properties": {
          "authority": {"type": "string", "minLength": 1},
          "allowed_uses": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "required_metadata": {"type": "array", "items": {"type": "string"}},
          "recheck_policy": {"type": "string"},
          "citation_mode": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "confidence_levels": {"type": "object", "required": ["HIGH", "MODERATE", "LOW", "PRACTICE_ONLY", "UNRESOLVED"], "additionalProperties": {"type": "string"}},
    "exclusion_reasons": {"type": "array", "minItems": 12, "items": {"type": "string"}},
    "question_domains": {"type": "array", "minItems": 17, "items": {"type": "string"}},
    "freshness_policies": {"type": "object", "additionalProperties": {"type": "object"}}
  },
  "additionalProperties": false
}
