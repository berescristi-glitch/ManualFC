{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manual-u11.local/schemas/claim-registry.schema.json",
  "type": "object",
  "required": ["schema_version", "claims"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "2.0.0"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "statement", "claim_type", "domain", "volume_id", "chapter_id", "source_ids", "source_locators", "confidence", "population", "limitations", "allowed_wording", "forbidden_overstatements", "verified_at", "next_review_at", "status", "replacement_claim_id"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^CLM-[0-9]{4,}$"},
          "statement": {"type": "string", "minLength": 10},
          "claim_type": {"enum": ["FACT", "OFFICIAL_RECOMMENDATION", "STUDY_RESULT", "CONSENSUS", "PRACTICE", "OPINION", "METHODOLOGICAL_SYNTHESIS"]},
          "domain": {"type": "string", "minLength": 2},
          "volume_id": {"type": "string", "pattern": "^VOLUME-(?:0[1-9]|10)$"},
          "chapter_id": {"type": ["string", "null"]},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SRC-[0-9]{4,}$"}},
          "source_locators": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "confidence": {"enum": ["HIGH", "MODERATE", "LOW", "PRACTICE_ONLY", "UNRESOLVED"]},
          "epistemic_level": {"enum": ["HIGH", "MODERATE", "LOW", "PRACTICE_ONLY", "UNRESOLVED"]},
          "population": {"type": "string", "minLength": 2},
          "participant_age": {"type": "string", "minLength": 2},
          "context": {"enum": ["FOOTBALL", "OTHER_SPORT", "MULTISPORT", "GENERAL_POPULATION", "CONCEPTUAL_YOUTH_SPORT"]},
          "u11_applicability": {"enum": ["DIRECT", "PARTIAL", "INDIRECT"]},
          "practical_implication": {"type": "string", "minLength": 5},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "allowed_wording": {"type": "string", "minLength": 5},
          "forbidden_overstatements": {"type": "array", "items": {"type": "string"}},
          "verified_at": {"type": "string", "format": "date"},
          "next_review_at": {"type": ["string", "null"], "format": "date"},
          "status": {"enum": ["PROPOSED", "VERIFIED", "CONTESTED", "OUTDATED", "WITHDRAWN", "REPLACED"]},
          "replacement_claim_id": {"type": ["string", "null"], "pattern": "^CLM-[0-9]{4,}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
