---
import type { SurfaceMapSpec } from '../lib/surface-map';

interface Props {
  spec: SurfaceMapSpec;
  exerciseId: string;
  exerciseTitle: string;
  totalPlayers: number;
  coachCount: 1 | 2;
}
const { spec, exerciseId, exerciseTitle, totalPlayers, coachCount } = Astro.props;
const domId = `map-${exerciseId}-${totalPlayers}-${coachCount}`;
const padX = 3;
const padTop = 2;
const padBottom = 6;
const viewW = spec.totalWidth + padX * 2 + 6;
const viewH = spec.totalHeight + padTop + padBottom;
const originX = padX + 6;
const originY = padTop;
---
<figure class="surface-map">
  <svg viewBox={`0 0 ${viewW} ${viewH}`} role="img" aria-labelledby={`${domId}-title`} aria-describedby={`${domId}-desc`}>
    <title id={`${domId}-title`}>Harta terenului — {exerciseTitle}, {totalPlayers} copii, {coachCount} {coachCount === 1 ? 'antrenor' : 'antrenori'}</title>
    <desc id={`${domId}-desc`}>{spec.areas.length} grupe active de {Math.round(spec.areas[0]?.width ?? 0)}×{Math.round(spec.totalHeight)} metri fiecare, așezate una lângă alta cu marjă de siguranță între ele. {coachCount === 1 ? 'Un antrenor' : 'Doi antrenori'} poziționat{coachCount === 1 ? '' : 'i'} sub grupe. Zonă de echipament în stânga.</desc>

    {spec.areas.map((area) => (
      <g transform={`translate(${originX + area.x}, ${originY + area.y})`}>
        <rect class="area-rect" width={area.width} height={area.height} rx="0.3" />
        <text class="area-label" x={area.width / 2} y={area.height / 2 - 0.3}>{area.label}</text>
        <text class="area-dims" x={area.width / 2} y={area.height / 2 + 0.9}>{Math.round(area.width)}×{Math.round(area.height)} m</text>
      </g>
    ))}

    <g transform={`translate(${originX + spec.equipmentMarker.x}, ${originY + spec.equipmentMarker.y})`}>
      <rect class="equipment-rect" x="-1.3" y="-1.3" width="2.6" height="2.6" rx="0.3" />
      <text class="equipment-label" y="2.6">Echipament</text>
    </g>

    {spec.coachMarkers.map((marker) => (
      <g transform={`translate(${originX + marker.x}, ${originY + marker.y})`}>
        <circle class="coach-marker" r="1" />
        <text class="coach-label" y="2.3">{marker.label}</text>
      </g>
    ))}
  </svg>
  <figcaption>
    <span class="buffer-note">{spec.bufferNote}</span>
    {spec.waitingNote && <span class="waiting-note">{spec.waitingNote}</span>}
  </figcaption>
</figure>

<style>
  .surface-map { margin: var(--space-4) 0; }
  .surface-map svg { width: 100%; height: auto; max-width: 34rem; }
  .area-rect { fill: #EEF0EA; stroke: var(--color-brand-gold); stroke-width: .12; }
  .area-label { font: 700 .85px var(--font-family-base); fill: var(--color-text-primary); text-anchor: middle; }
  .area-dims { font: 400 .65px var(--font-family-mono); fill: var(--color-text-muted); text-anchor: middle; }
  .equipment-rect { fill: none; stroke: var(--color-text-muted); stroke-width: .12; stroke-dasharray: .3 .3; }
  .equipment-label { font: 700 .6px var(--font-family-base); fill: var(--color-text-muted); text-anchor: middle; }
  .coach-marker { fill: var(--color-bg-brand); }
  .coach-label { font: 700 .65px var(--font-family-base); fill: var(--color-text-primary); text-anchor: middle; }
  figcaption { margin-top: var(--space-2); display: grid; gap: .2rem; font-size: .8rem; color: var(--color-text-muted); }
</style>
