---
export type CanonicalEvidenceLevel = 'HIGH' | 'MODERATE' | 'LOW' | 'PRACTICE_ONLY' | 'UNRESOLVED';
interface Props { level: CanonicalEvidenceLevel; showSymbol?: boolean; }
const { level, showSymbol = true } = Astro.props;
const labels: Record<CanonicalEvidenceLevel,string> = { HIGH:'Puternice', MODERATE:'Moderate', LOW:'Limitate', PRACTICE_ONLY:'Practică profesională', UNRESOLVED:'În verificare' };
---
<span class={`evidence-badge evidence-${level.toLowerCase()}`}>
  {showSymbol && <span aria-hidden="true">DOVEZI</span>}
  <strong>{labels[level] ?? labels.UNRESOLVED}</strong>
</span>
<style>
  .evidence-badge { display:inline-flex; align-items:center; gap:.55rem; color:var(--color-text-primary); font-size:.72rem; letter-spacing:.08em; line-height:1.2; text-transform:uppercase; }
  .evidence-badge span { border-inline-end:1px solid var(--color-border-strong); padding-inline-end:.55rem; }
  .evidence-badge::before { content:""; width:7px; height:7px; background:var(--color-steel); transform:rotate(45deg); }
  .evidence-high::before { background:#2E7D32; } .evidence-moderate::before { background:#1769AA; } .evidence-low::before { background:#9A6D00; } .evidence-unresolved::before { background:#991B1B; }
</style>
