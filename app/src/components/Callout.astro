---
interface Props {
  type?: 'info' | 'warning' | 'evidence' | 'pedagogical' | 'danger';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const typeStyles: Record<string, { color: string; symbol: string }> = {
  info: { color: "var(--color-border-accent)", symbol: "ℹ️" },
  warning: { color: "var(--color-warning)", symbol: "⚠️" },
  evidence: { color: "var(--color-evidence)", symbol: "🔬" },
  pedagogical: { color: "var(--color-pedagogical)", symbol: "💡" },
  danger: { color: "var(--color-danger)", symbol: "🚨" }
};

const style = typeStyles[type] || typeStyles.info;
---
<aside class="callout-box" style={`--callout-accent: ${style.color};`}>
  {title && (
    <div class="callout-header">
      <span aria-hidden="true">{style.symbol}</span>
      <strong>{title}</strong>
    </div>
  )}
  <div class="callout-body">
    <slot />
  </div>
</aside>

<style>
  .callout-box {
    background-color: var(--color-bg-surface-muted);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--callout-accent);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-6);
    margin: var(--space-4) 0;
  }
  .callout-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-base);
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }
  .callout-body {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
  }
</style>
