---
interface Props { eyebrow:string; title:string; objective:string; relation:string; players:string; field:string; duration:string; equipment:string; childMessage:string; observable:string }
const { eyebrow,title,objective,relation,players,field,duration,equipment,childMessage,observable } = Astro.props;
---
<header class="field-summary" id="rezumat-teren">
  <p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p class="objective">{objective}</p>
  <dl class="field-facts"><div><dt>Format</dt><dd>{relation} · {players}</dd></div><div><dt>Spațiu</dt><dd>{field}</dd></div><div><dt>Timp</dt><dd>{duration}</dd></div><div><dt>Materiale</dt><dd>{equipment}</dd></div></dl>
  <div class="field-focus"><div><span>Spune exact</span><blockquote>„{childMessage}”</blockquote></div><div><span>Urmărește</span><p>{observable}</p></div></div>
</header>
<style>
  .field-summary{padding:clamp(2rem,5vw,4rem);background:var(--color-bg-brand);color:white;border-top:3px solid var(--color-brand-gold)}.eyebrow{color:var(--color-brand-gold)}h1{max-width:22ch;margin:.75rem 0 1rem;color:white}.objective{max-width:68ch;color:#E4E8ED;font-size:1.08rem}
  .field-facts{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;margin:var(--space-8) 0 0;background:rgba(255,255,255,.16)}.field-facts>div{padding:1rem;background:var(--color-bg-brand-secondary)}dt,.field-focus span{font-size:.65rem;font-weight:850;letter-spacing:.09em;text-transform:uppercase;color:var(--color-brand-gold)}dd{margin:.35rem 0 0;color:white;font-weight:750}
  .field-focus{display:grid;grid-template-columns:1.2fr .8fr;gap:var(--space-8);margin-top:var(--space-8);padding-top:var(--space-6);border-top:1px solid rgba(255,255,255,.18)}blockquote{margin:.5rem 0 0;padding:0;border:0;color:white;font:750 clamp(1.2rem,2.3vw,1.7rem)/1.3 var(--font-family-heading)}.field-focus p{color:#E4E8ED;margin:.5rem 0 0}
  @media(max-width:800px){.field-facts{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.field-summary{padding:1.5rem}.field-facts,.field-focus{grid-template-columns:1fr}}@media print{.field-summary{background:white;color:black;border:1px solid #333}.field-summary h1,.field-summary dd,.field-summary blockquote,.field-summary p{color:black}}
</style>
