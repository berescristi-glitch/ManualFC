---
interface Props { variant?: 'pitch' | 'angle'; label?: string; }
const { variant = 'pitch', label = 'Geometrie tactică abstractă' } = Astro.props;
---
<svg class={`tactical-motif motif-${variant}`} viewBox="0 0 520 420" role="img" aria-labelledby="motif-title motif-desc">
  <title id="motif-title">{label}</title>
  <desc id="motif-desc">Linii de teren, marcaje de jucători și un traseu de pasă reprezentate abstract.</desc>
  <g class="pitch-lines">
    <path d="M40 36H480V384H40Z" />
    <path d="M260 36V384M40 210H480" />
    <circle cx="260" cy="210" r="56" />
    <path d="M40 132H120V288H40M480 132H400V288H480" />
  </g>
  <g class="route"><path d="M116 306L236 244L370 116" /><path d="M343 116H370V143" /></g>
  <g class="players"><circle cx="116" cy="306" r="11" /><circle cx="236" cy="244" r="11" /><circle cx="370" cy="116" r="11" /></g>
  <text x="52" y="64">U11 / 01</text><text x="385" y="365">OBSERVĂ → ALEGE</text>
</svg>
<style>
  .tactical-motif { width: 100%; height: auto; color: var(--color-brand-gold); }
  .pitch-lines { fill: none; stroke: currentColor; stroke-width: 1.25; opacity: .34; }
  .route { fill: none; stroke: currentColor; stroke-width: 3; stroke-dasharray: 7 7; }
  .players { fill: var(--color-bg-brand); stroke: currentColor; stroke-width: 4; }
  text { fill: currentColor; font: 700 11px var(--font-family-mono); letter-spacing: .08em; }
</style>
