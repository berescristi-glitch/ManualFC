---
interface Props {
  variant: 'ex-0001' | 'ex-0002' | 'ex-0003' | 'ex-0004' | 'ex-0005';
}
const { variant } = Astro.props;

const content: Record<Props['variant'], { title: string; desc: string; caption: string }> = {
  'ex-0001': {
    title: 'Diagramă tactică EX-0001 — Cine ne poate acoperi pe amândoi?',
    desc: 'Purtătorul mingii și coechipierul de sprijin sunt pe aceeași linie, ambii acoperiți simultan de un singur adversar. O săgeată arată coechipierul mutându-se lateral pentru a deschide un unghi nou, pe care adversarul nu îl mai poate acoperi în același timp cu purtătorul.',
    caption: 'Configurația de start (linie) vs. unghiul nou după deplasare — setup pentru acest exercițiu, nu o poziție geometrică ideală.'
  },
  'ex-0002': {
    title: 'Diagramă tactică EX-0002 — Creează opțiunea sub presiune reală',
    desc: 'Adversarul este activ și se apropie continuu de purtătorul mingii. Coechipierul de sprijin se repoziționează în mod repetat, pe măsură ce adversarul se mișcă, pentru a păstra un unghi de pasă deschis.',
    caption: 'Repoziționare continuă — coechipierul se adaptează de mai multe ori în aceeași fază, nu o singură dată.'
  },
  'ex-0003': {
    title: 'Diagramă tactică EX-0003 — Primește gata să continui',
    desc: 'Înainte de a primi mingea, coechipierul scanează conul colorat pentru a stabili direcția, apoi se orientează cu corpul spre acea direcție la recepție, păstrând o continuare posibilă a acțiunii.',
    caption: 'Scanează conul → orientează corpul la recepție — reperul e conul, nu o instrucțiune despre poziția piciorului.'
  },
  'ex-0004': {
    title: 'Diagramă tactică EX-0004 — Sprijin cu doi coechipieri',
    desc: 'Cei doi coechipieri de sprijin pornesc grupați instinctiv în aceeași zonă, unde un singur adversar îi poate acoperi pe amândoi. Două săgeți arată cum se diferențiază spațial pe linii diferite față de purtătorul mingii, astfel încât niciun adversar să nu îi mai poată acoperi simultan.',
    caption: 'Grupare instinctivă (fantomă) vs. diferențiere pe două linii — setup pentru acest exercițiu, nu o formă geometrică unică validă.'
  },
  'ex-0005': {
    title: 'Diagramă tactică EX-0005 — Transferul în joc mic',
    desc: 'Un moment posibil dintr-un joc liber 4v4: purtătorul mingii găsește un coechipier care a deschis un unghi de sprijin, neacoperit de adversarul cel mai apropiat. Restul jucătorilor (puncte estompate) sunt prezenți în joc, dar poziția lor exactă variază la fiecare fază reală — nu este o formație impusă.',
    caption: 'Un moment reprezentativ posibil, nu o formă obligatorie — poziția celorlalți 6 jucători variază la fiecare fază reală de joc.'
  }
};
const { title, desc, caption } = content[variant];
---
<figure class="tactical-diagram">
  <svg viewBox="0 0 400 260" role="img" aria-labelledby={`td-title-${variant} td-desc-${variant}`}>
    <title id={`td-title-${variant}`}>{title}</title>
    <desc id={`td-desc-${variant}`}>{desc}</desc>
    <g class="field"><rect x="10" y="10" width="380" height="240" rx="6" /></g>

    {variant === 'ex-0001' && (
      <g>
        <path class="lane-old" d="M90 190 L200 130" />
        <path class="lane-new" d="M90 190 L280 90" />
        <path class="move-arrow" d="M200 130 Q245 105 275 92" marker-end="url(#arrow)" />
        <g class="defender" transform="translate(190,150)"><polygon points="0,-14 13,10 -13,10" /></g>
        <g class="ball-carrier" transform="translate(90,190)"><circle r="13" /><circle class="ball" cx="10" cy="-10" r="4" /></g>
        <g class="support ghost" transform="translate(200,130)"><circle r="13" /></g>
        <g class="support" transform="translate(280,90)"><circle r="13" /></g>
        <text class="label" x="70" y="222">P</text>
        <text class="label" x="176" y="146">A</text>
        <text class="label" x="298" y="94">S</text>
      </g>
    )}

    {variant === 'ex-0002' && (
      <g>
        <path class="lane-new" d="M80 200 L260 70" />
        <path class="move-arrow" d="M150 150 Q190 110 230 85" marker-end="url(#arrow)" stroke-dasharray="5 5" />
        <path class="move-arrow" d="M230 85 Q250 60 260 70" marker-end="url(#arrow)" stroke-dasharray="5 5" />
        <g class="defender" transform="translate(150,175)"><polygon points="0,-14 13,10 -13,10" /></g>
        <g class="ball-carrier" transform="translate(80,200)"><circle r="13" /><circle class="ball" cx="10" cy="-10" r="4" /></g>
        <g class="support ghost" transform="translate(150,150)"><circle r="11" /></g>
        <g class="support" transform="translate(260,70)"><circle r="13" /></g>
        <text class="label" x="60" y="232">P</text>
        <text class="label" x="136" y="172">A</text>
        <text class="label" x="278" y="74">S</text>
      </g>
    )}

    {variant === 'ex-0003' && (
      <g>
        <path class="lane-new" d="M100 200 L260 130" />
        <path class="move-arrow" d="M260 130 L320 100" marker-end="url(#arrow)" />
        <g class="cone" transform="translate(300,150)"><rect x="-9" y="-9" width="18" height="18" transform="rotate(45)" /></g>
        <path class="scan-line" d="M260 130 L300 150" stroke-dasharray="3 4" />
        <g class="defender" transform="translate(190,155)"><polygon points="0,-14 13,10 -13,10" /></g>
        <g class="ball-carrier" transform="translate(100,200)"><circle r="13" /><circle class="ball" cx="10" cy="-10" r="4" /></g>
        <g class="support" transform="translate(260,130)"><circle r="13" /></g>
        <text class="label" x="80" y="232">P</text>
        <text class="label" x="176" y="150">A</text>
        <text class="label" x="240" y="118">S</text>
        <text class="label cone-label" x="290" y="180">con</text>
      </g>
    )}

    {variant === 'ex-0004' && (
      <g>
        <path class="move-arrow" d="M270 130 Q260 95 245 75" marker-end="url(#arrow)" stroke-dasharray="5 5" />
        <path class="move-arrow" d="M270 130 Q305 140 328 148" marker-end="url(#arrow)" stroke-dasharray="5 5" />
        <g class="defender" transform="translate(150,190)"><polygon points="0,-14 13,10 -13,10" /></g>
        <g class="defender" transform="translate(232,150)"><polygon points="0,-14 13,10 -13,10" /></g>
        <g class="ball-carrier" transform="translate(80,210)"><circle r="13" /><circle class="ball" cx="10" cy="-10" r="4" /></g>
        <g class="support ghost" transform="translate(270,130)"><circle r="13" /></g>
        <g class="support" transform="translate(245,70)"><circle r="13" /></g>
        <g class="support" transform="translate(330,150)"><circle r="13" /></g>
        <text class="label" x="60" y="232">P</text>
        <text class="label" x="136" y="212">A1</text>
        <text class="label" x="218" y="172">A2</text>
        <text class="label" x="245" y="52">S1</text>
        <text class="label" x="330" y="132">S2</text>
      </g>
    )}

    {variant === 'ex-0005' && (
      <g>
        <rect class="goal" x="8" y="105" width="8" height="50" />
        <rect class="goal" x="384" y="105" width="8" height="50" />
        <path class="lane-new" d="M120 200 L235 110" />
        <g class="defender faint" transform="translate(90,70)"><polygon points="0,-12 11,9 -11,9" /></g>
        <g class="defender faint" transform="translate(210,215)"><polygon points="0,-12 11,9 -11,9" /></g>
        <g class="defender faint" transform="translate(320,60)"><polygon points="0,-12 11,9 -11,9" /></g>
        <g class="support faint" transform="translate(300,205)"><circle r="11" /></g>
        <g class="support faint" transform="translate(60,110)"><circle r="11" /></g>
        <g class="defender" transform="translate(175,155)"><polygon points="0,-14 13,10 -13,10" /></g>
        <g class="ball-carrier" transform="translate(120,200)"><circle r="13" /><circle class="ball" cx="10" cy="-10" r="4" /></g>
        <g class="support" transform="translate(235,110)"><circle r="13" /></g>
        <text class="label" x="100" y="222">P</text>
        <text class="label" x="161" y="177">A</text>
        <text class="label" x="253" y="94">S</text>
      </g>
    )}

    <defs>
      <marker id="arrow" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 Z" /></marker>
    </defs>
  </svg>
  <figcaption>
    {caption}<br />
    {variant === 'ex-0004'
      ? <span class="legend">● purtător cu minge (P) · ▲ adversari (A1, A2) · ○ coechipieri de sprijin (S1, S2)</span>
      : variant === 'ex-0005'
        ? <span class="legend">● purtător cu minge (P) · ▲ adversar (A) · ○ coechipier de sprijin (S) · puncte estompate — ceilalți 6 jucători, poziție ilustrativă</span>
        : <span class="legend">● purtător cu minge (P) · ▲ adversar (A) · ○ coechipier de sprijin (S)</span>}
  </figcaption>
</figure>

<style>
  .tactical-diagram { margin: var(--space-6) 0 0; }
  .tactical-diagram svg { width: 100%; height: auto; max-width: 420px; }
  .field rect { fill: #EEF0EA; stroke: var(--color-border-strong); stroke-width: 1.5; }
  .lane-old { fill: none; stroke: var(--color-text-muted); stroke-width: 2; stroke-dasharray: 2 5; }
  .lane-new { fill: none; stroke: var(--color-brand-gold); stroke-width: 2.5; }
  .scan-line { fill: none; stroke: var(--color-text-muted); stroke-width: 1.5; }
  .move-arrow { fill: none; stroke: var(--color-text-primary); stroke-width: 2; }
  #arrow path { fill: var(--color-text-primary); }
  .ball-carrier circle:first-child { fill: var(--color-bg-brand); stroke: var(--color-bg-brand); }
  .ball-carrier .ball { fill: var(--color-brand-gold); stroke: none; }
  .defender polygon { fill: white; stroke: var(--color-text-primary); stroke-width: 2.5; }
  .support circle { fill: white; stroke: var(--color-brand-gold); stroke-width: 2.5; }
  .support.ghost circle { fill: none; stroke: var(--color-text-muted); stroke-width: 1.5; stroke-dasharray: 2 3; opacity: .6; }
  .cone rect { fill: var(--color-brand-gold); stroke: var(--color-bg-brand); stroke-width: 1; }
  .goal { fill: none; stroke: var(--color-text-primary); stroke-width: 2.5; }
  .defender.faint polygon { fill: white; stroke: var(--color-text-muted); stroke-width: 2; opacity: .45; }
  .support.faint circle { fill: white; stroke: var(--color-text-muted); stroke-width: 2; opacity: .45; }
  .label { font: 700 12px var(--font-family-mono); fill: var(--color-text-primary); text-anchor: middle; }
  .cone-label { font-size: 9px; fill: var(--color-text-muted); }
  figcaption { margin-top: var(--space-3); font-size: .85rem; color: var(--color-text-secondary); max-width: 48ch; }
  figcaption .legend { display: block; margin-top: .3rem; font-size: .78rem; color: var(--color-text-muted); }
</style>
