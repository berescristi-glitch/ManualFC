---
interface Props {
  variant?: 'default' | 'interactive' | 'pedagogical' | 'evidence' | 'warning' | 'quick-action';
  href?: string;
  title?: string;
}

const { variant = 'default', href, title } = Astro.props;
---
<div class={`ui-card card-${variant}`}>
  {title && (
    <div class="card-header">
      {href ? (
        <a href={href} class="card-title-link"><h4>{title}</h4></a>
      ) : (
        <h4 class="card-title">{title}</h4>
      )}
    </div>
  )}
  <div class="card-body">
    <slot />
  </div>
</div>

<style>
  .ui-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    margin: var(--space-4) 0;
  }
  .card-interactive:hover {
    border-color: var(--color-border-accent);
    background-color: var(--color-bg-surface-muted);
  }
  .card-pedagogical { border-top: 4px solid var(--color-pedagogical); }
  .card-evidence { border-top: 4px solid var(--color-evidence); }
  .card-warning { border-top: 4px solid var(--color-warning); }
  .card-quick-action { border-top: 4px solid var(--color-role-possession); }

  .card-title {
    color: var(--color-text-primary);
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-2);
  }
  .card-title-link {
    color: var(--color-text-accent);
    text-decoration: none;
  }
  .card-title-link:hover {
    text-decoration: underline;
  }
  .card-body {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
  }
</style>
