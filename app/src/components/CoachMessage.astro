---
import ChildMessage from './ChildMessage.astro';
import type { CoachMessageProps } from '../types';
interface Props extends CoachMessageProps { phrasesToAvoid?: string[]; understandingCheck?: string; matchTransfer?: string; }
const { childStatement, coachExplanation, pedagogicalRationale, targetBehavior, ageAppropriateness = "Adecvat categoriei 10–11 ani", phrasesToAvoid, understandingCheck, matchTransfer } = Astro.props;
---
<div class="coach-message-container">
  <ChildMessage wording={childStatement} />
  <section class="coach-meaning" aria-label="Sens pentru antrenor">
    <header><span class="eyebrow">Ce urmărești de fapt</span><h3>Sens pentru antrenor</h3></header>
    <p class="coach-explanation">{coachExplanation}</p>
    <div class="reasoning-grid">
      <div><span>De ce</span><p>{pedagogicalRationale}</p></div>
      <div><span>Comportament observabil</span><p>{targetBehavior}</p></div>
    </div>
    {(phrasesToAvoid || understandingCheck || matchTransfer) && <div class="extended-model">
      {phrasesToAvoid?.length && <div><span>De evitat</span><ul>{phrasesToAvoid.map(p => <li>„{p}”</li>)}</ul></div>}
      {understandingCheck && <div><span>Cum verifici</span><p>{understandingCheck}</p></div>}
      {matchTransfer && <div><span>Transfer în joc</span><p>{matchTransfer}</p></div>}
    </div>}
    <footer>{ageAppropriateness}</footer>
  </section>
</div>
<style>
  .coach-message-container { margin: var(--space-8) 0; }
  .coach-meaning { background: white; border-bottom: 1px solid var(--color-border); padding: clamp(2rem,5vw,4rem); }
  header { display: grid; grid-template-columns: 1fr 2fr; gap: var(--space-8); border-bottom: 1px solid var(--color-border); margin-bottom: var(--space-8); }
  header h3 { font-size: clamp(1.8rem,3vw,2.8rem); }
  .coach-explanation { color: var(--color-text-primary); font-size: clamp(1.15rem,2vw,1.45rem); font-weight: 600; }
  .reasoning-grid, .extended-model { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1px; background: var(--color-border); border-block: 1px solid var(--color-border); }
  .reasoning-grid > div, .extended-model > div { background: white; padding: var(--space-6) 0; }
  .reasoning-grid > div:nth-child(even), .extended-model > div:nth-child(even) { padding-left: var(--space-6); }
  .reasoning-grid span, .extended-model span { display:block; margin-bottom:.6rem; color:var(--color-text-accent); font-size:.7rem; font-weight:850; letter-spacing:.11em; text-transform:uppercase; }
  .reasoning-grid p, .extended-model p, .extended-model ul { margin:0; font-size:.92rem; }
  .extended-model { grid-template-columns: repeat(3,minmax(0,1fr)); margin-top: var(--space-8); border-top: 0; }
  footer { margin-top: var(--space-6); color: var(--color-text-muted); font-size:.72rem; text-transform:uppercase; letter-spacing:.08em; }
  @media (max-width: 680px) { header, .reasoning-grid, .extended-model { grid-template-columns:1fr; } .reasoning-grid > div:nth-child(even), .extended-model > div:nth-child(even) { padding-left:0; } }
</style>
