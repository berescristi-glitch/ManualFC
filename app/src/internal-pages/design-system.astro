---
import BaseLayout from '../layouts/BaseLayout.astro';
import TacticalMotif from '../components/TacticalMotif.astro';
import ManualFCLogo from '../components/ManualFCLogo.astro';
import CoachMessage from '../components/CoachMessage.astro';
import EvidenceBadge from '../components/EvidenceBadge.astro';
import QuickModePattern from '../components/QuickModePattern.astro';
---
<BaseLayout title="Brand / UI Lab" description="Laborator intern pentru identitatea și componentele ManualFC.">
  <Fragment slot="head"><meta name="robots" content="noindex,nofollow" /></Fragment>
  <div class="lab-banner" role="alert"><strong>INTERNAL / DEVELOPMENT ONLY.</strong> Laborator intern de brand și interfață; ruta nu este conținut editorial public.</div>
  <header class="lab-hero on-dark"><div><span class="eyebrow">ManualFC · Brand / UI Lab</span><h1>Editorial în lectură.<br /><em>Tactic pe teren.</em></h1><p>Prima expresie a identității Hybrid Editorial + Tactical.</p></div><TacticalMotif /></header>

  <section class="lab-section official-identity"><header><span>00</span><div><span class="eyebrow">Identitate canonică V2 · DEC-0080</span><h2>Logo oficial ManualFC</h2></div></header>
    <p class="identity-note">Artwork-ul sursă (clipboard + M + minge, fundal navy) este o imagine plată, fără variantă deschisă sau transparentă oficială. Toate derivatele de mai jos sunt decupări/redimensionări ale aceluiași master — nu există o versiune „light surface" sau inversată.</p>
    <div class="logo-specimens">
      <article class="logo-dark-surface"><span>Full lockup · cu tagline</span><ManualFCLogo variant="full" class="lab-full-logo" /></article>
      <article class="logo-dark-surface"><span>Horizontal lockup · fără tagline</span><ManualFCLogo variant="horizontal" class="lab-full-logo" /></article>
      <article class="mark-surface"><span>Brand mark</span><ManualFCLogo variant="mark" class="lab-mark" /></article>
    </div>
    <div class="brand-rules">
      <article><span class="eyebrow">Clear space</span><h3>Minimum X în jurul lockup-ului</h3><p>X este jumătate din înălțimea mark-ului. Niciun text sau element grafic nu intră în această zonă.</p></article>
      <article><span class="eyebrow">Minimum size</span><h3>Horizontal: 120 px · Mark: 32 px</h3><p>Sub aceste praguri, wordmark-ul sau mark-ul își pierd lizibilitatea. Pentru favicon se folosesc derivatele dedicate (16/32/48 px).</p></article>
    </div>
    <div class="brand-dont"><span class="eyebrow">Do not</span><ul><li>Nu întinde, comprima sau roti logo-ul.</li><li>Nu recolora arbitrar.</li><li>Nu aplica umbre, gradient-uri sau filtre suplimentare.</li><li>Nu recrea logo-ul din memorie folosind HTML/CSS.</li><li>Nu înlocui cu emoji sau iconițe generice.</li><li>Nu inversa culorile sau crea o variantă „light" neoficială.</li><li>Nu folosi identitatea shield/crest anterioară.</li></ul></div>
  </section>

  <section class="lab-section"><header><span>01</span><div><span class="eyebrow">Fundație</span><h2>Paletă și tipografie</h2></div></header><div class="palette"><div class="navy"><b>Midnight Navy</b><code>#010916</code></div><div class="deep"><b>Deep Navy</b><code>#1B263B</code></div><div class="gold"><b>ManualFC Gold</b><code>#F4C430</code></div><div class="paper"><b>Warm Off-White</b><code>#F7F7F2</code></div><div class="steel"><b>Steel Grey</b><code>#8D99AE</code></div></div><div class="type-spec"><span>DISPLAY / 01</span><p>Înțelege copilul.<br />Antrenează jocul.</p><small>Body — Lectură calmă, precisă, cu lungimea rândului controlată pentru explicația pedagogică.</small></div></section>

  <section class="lab-section"><header><span>02</span><div><span class="eyebrow">Primitive</span><h2>Acțiuni și motiv tactic</h2></div></header><div class="button-row"><a class="button button-primary" href="#mesaje">Acțiune principală</a><a class="button button-secondary dark-outline" href="#moduri">Acțiune secundară</a></div><div class="motif-sample"><TacticalMotif label="Primtivă tactică ManualFC" /></div></section>

  <section id="moduri" class="lab-section"><header><span>03</span><div><span class="eyebrow">Două intenții</span><h2>Mode A / Mode B</h2></div></header><div class="mode-demo"><article><span class="eyebrow">Vreau să învăț</span><h3>Lectură editorială, progresivă.</h3><p>Ideea este desfăcută până când antrenorul o poate adapta independent.</p></article><article class="on-dark"><span class="eyebrow">Am nevoie acum</span><h3>Acțiune densă, pe teren.</h3><ol><li>Observă</li><li>Nu presupune</li><li>Modifică</li></ol></article></div></section>

  <section id="mesaje" class="lab-section"><header><span>04</span><div><span class="eyebrow">Semnătură pedagogică</span><h2>Copil / Antrenor</h2></div></header><CoachMessage childStatement="Privește înainte să primești mingea." coachExplanation="Mesajul mută atenția spre informația disponibilă înaintea execuției." pedagogicalRationale="Copilul are nevoie de un reper observabil, nu de o comandă despre rezultat." targetBehavior="Ridică privirea și își orientează corpul înainte de contact." understandingCheck="Întreabă: «Ce ai văzut înainte să vină mingea?»" /></section>

  <section class="lab-section"><header><span>05</span><div><span class="eyebrow">Distincție intelectuală</span><h2>Observație / Interpretare</h2></div></header><div class="observe-demo"><article><span>FAPT OBSERVABIL</span><h3>Ce observi</h3><p>Copilul primește mingea cu privirea în jos și se oprește.</p></article><aside><span>IPOTEZĂ DE TESTAT</span><h3>Ce poate însemna</h3><p>Poate să nu fi văzut presiunea. Nu concluziona că „nu înțelege jocul”.</p></aside></div></section>

  <section class="lab-section"><header><span>06</span><div><span class="eyebrow">Evidence</span><h2>Rigoare fără gamification</h2></div></header><div class="evidence-demo"><EvidenceBadge level="MODERATE" /><p>Aplicabilitate parțială U11 · numărul de surse vine numai din registrul canonic.</p></div><div class="limitation-demo"><span class="eyebrow">Ce nu putem concluziona</span><p>Un comportament observat într-o singură repetare nu justifică un verdict despre capacitatea sau potențialul copilului.</p></div></section>

  <section class="lab-section"><header><span>07</span><div><span class="eyebrow">Field tool</span><h2>Quick Field Card</h2></div></header><QuickModePattern problemTitle="Jucătorul pierde mingea imediat după primire"><div slot="observe"><p>Primește cu corpul închis.</p></div><div slot="causes"><p>Nu presupune lipsă de atenție.</p></div><div slot="say"><p>„Privește înainte să primești.”</p></div><div slot="why"><p>Caută informația înaintea execuției.</p></div><div slot="action"><p>Mărește ușor timpul sau spațiul.</p></div><div slot="adaptation"><p>Repetă și compară comportamentul.</p></div></QuickModePattern></section>
</BaseLayout>
<style>
  .lab-banner{padding:1rem;border:1px solid var(--color-border-strong);font-size:.8rem}.lab-hero{width:100vw;margin-left:calc(50% - 50vw);display:grid;grid-template-columns:1.3fr .7fr;align-items:center;background:var(--color-bg-brand);padding:var(--space-20) max(1rem,calc((100vw - var(--width-wide))/2))}.lab-hero .eyebrow,.lab-hero h1 em{color:var(--color-brand-gold);font-style:normal}.lab-section{padding:var(--space-20) 0;border-bottom:1px solid var(--color-border)}.lab-section>header{display:grid;grid-template-columns:.5fr 2.5fr;margin-bottom:var(--space-12)}.lab-section>header>span{font:700 .7rem var(--font-family-mono);color:var(--color-text-accent)}
  .identity-note{max-width:60ch;color:var(--color-text-secondary);font-size:.9rem;margin-bottom:var(--space-8)}.logo-specimens{display:grid;grid-template-columns:repeat(3,1fr)}.logo-specimens article{min-height:230px;padding:var(--space-8);display:flex;flex-direction:column;justify-content:space-between;border:1px solid var(--color-border)}.logo-specimens article>span{font:.7rem var(--font-family-mono);letter-spacing:.08em;text-transform:uppercase}.logo-dark-surface{background:var(--color-bg-brand);color:#F7F7F2}.mark-surface{align-items:center;background:white}.logo-specimens :global(.lab-full-logo){width:min(100%,320px)}.logo-specimens :global(.lab-mark){width:150px}.brand-rules{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-8);margin-top:var(--space-12)}.brand-rules article{padding-top:var(--space-6);border-top:1px solid var(--color-border)}.brand-dont{margin-top:var(--space-12);padding:var(--space-8);background:#E7E8E2;border-block:1px solid var(--color-border-strong)}.brand-dont ul{columns:2;margin-top:var(--space-4)}
  .palette{display:grid;grid-template-columns:repeat(5,1fr)}.palette>div{min-height:150px;padding:1rem;display:flex;flex-direction:column;justify-content:space-between;font-size:.78rem}.palette code{font-size:.7rem}.navy{background:var(--color-bg-brand);color:white}.deep{background:#1B263B;color:white}.gold{background:#F4C430}.paper{background:#F7F7F2;border:1px solid var(--color-border)}.steel{background:#8D99AE}.type-spec{padding:var(--space-12) 0}.type-spec>span{font:.7rem var(--font-family-mono)}.type-spec>p{font:850 clamp(2.5rem,6vw,6rem)/.95 var(--font-family-heading);color:var(--color-text-primary)}.type-spec small{font-size:1rem}.button-row{display:flex;gap:1rem;flex-wrap:wrap}.dark-outline{color:var(--color-bg-brand)}.motif-sample{max-width:500px;margin:var(--space-8) auto}.mode-demo,.observe-demo{display:grid;grid-template-columns:1.15fr .85fr}.mode-demo article,.observe-demo article,.observe-demo aside{padding:clamp(2rem,5vw,4rem);background:white}.mode-demo article:last-child{background:var(--color-bg-brand-secondary)}.mode-demo article:last-child .eyebrow{color:var(--color-brand-gold)}.observe-demo article{border-top:3px solid var(--color-bg-brand)}.observe-demo aside{background:#E7E8E2;border-left:1px solid var(--color-border)}.observe-demo span{font-size:.7rem;font-weight:850;letter-spacing:.1em}.evidence-demo{display:flex;gap:2rem;align-items:center;padding:var(--space-8) 0;border-block:1px solid var(--color-border)}.evidence-demo p{margin:0}.limitation-demo{padding:var(--space-8);margin-top:var(--space-8);background:#E7E8E2;border-block:1px solid var(--color-border-strong)}
  @media(max-width:760px){.lab-hero{grid-template-columns:1fr}.palette{grid-template-columns:repeat(2,1fr)}.mode-demo,.observe-demo,.logo-specimens,.brand-rules{grid-template-columns:1fr}.mark-surface{grid-column:auto}.brand-dont ul{columns:1}.lab-section>header{grid-template-columns:2rem 1fr}.evidence-demo{align-items:flex-start;flex-direction:column}}
  @media(max-width:390px){.palette{grid-template-columns:1fr}.lab-section{padding-block:var(--space-12)}}
</style>
