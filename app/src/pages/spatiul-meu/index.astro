---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumb from '../../components/Breadcrumb.astro';
import { getGoldStandardExercises, getGoldStandardSessions } from '../../lib/content-bridge';
import { getMediaForExercise } from '../../lib/media-registry';
import type { ResourceLookup } from '../../lib/offline-pack';

const exercises = getGoldStandardExercises();
const sessions = getGoldStandardSessions();
const resourceLookup: ResourceLookup = {
  exercises: Object.fromEntries(exercises.map((ex) => [ex.id, {
    id: ex.id,
    route: `/gold-standard/exercitii/${ex.id}`,
    mediaIds: getMediaForExercise(ex.id).map((m) => m.media_id)
  }])),
  sessions: Object.fromEntries(sessions.map((ses) => [ses.id, {
    id: ses.id,
    route: `/gold-standard/sedinte/${ses.id}`,
    // Field Mode is fully static-rendered; ?durata= is read client-side only, so the
    // same cached HTML serves both variants via the service worker's ignoreSearch match.
    fieldModeRoutes: [`/gold-standard/sedinte/${ses.id}/mod-teren`]
  }])),
  sharedRoutes: ['/gold-standard/fise-de-teren', '/gold-standard/configurator']
};
---
<BaseLayout title="Spațiul meu" description="Spațiul local-first al antrenorului: continuare, conținut salvat, favorite, ședințe proprii, reflecții și disponibilitate pe teren.">
  <Breadcrumb items={[{label:'Acasă',href:'/'},{label:'Spațiul meu'}]}/>
  <header class="workspace-head"><p class="eyebrow">COACH OPERATING SYSTEM · LOCAL-FIRST</p><h1>Spațiul meu</h1><p>Pregătește munca de teren fără cont și fără date despre copii. Informația rămâne în acest browser.</p></header>
  <p class="conn-status" data-conn-status hidden></p>
  <section data-onboarding class="onboarding" hidden><h2>Setează punctul de plecare</h2><p>Aceste preferințe personalizează numai configurațiile inițiale; nu evaluează antrenorul și nu profilează copiii.</p><form><label>Experiență<select name="experience"><option value="incepator">La început</option><option value="intermediar">Intermediar</option><option value="experimentat">Experimentat</option></select></label><label>Efectiv uzual<input name="players" type="number" min="8" max="18" value="12"/></label><label>Durată uzuală<select name="duration"><option value="75">75 minute</option><option value="60">60 minute</option></select></label><button>Salvează preferințele</button></form></section>
  <section class="continue"><div><p class="eyebrow">CONTINUĂ</p><h2 data-continue-title>Începe cu o problemă reală de joc</h2><p data-continue-copy>Deschide o observație sau construiește prima ședință.</p></div><a data-continue-link href="/rezolva-pe-teren">Rezolvă o problemă →</a></section>
  <div class="workspace-grid" data-resource-lookup={JSON.stringify(resourceLookup)}><section><h2>Ședințele mele</h2><p><a class="primary" href="/spatiul-meu/sedinta">Construiește o ședință</a></p><div data-sessions></div></section><section><h2>Reflecții</h2><div data-reflections></div></section><section><h2>Salvate</h2><div data-saved class="ref-list"></div></section><section><h2>Favorite</h2><div data-favorites class="ref-list"></div></section><section><h2>Vizitate recent</h2><div data-recents class="ref-list"></div></section></div>
</BaseLayout>
<script>
 import {browserCoachStatePort,updateCoachState,clampPlayers,deleteWorkspaceSession,deleteReflection,findUnreflectedSession,computeNextAction,saveOfflinePack,findOfflinePackForSession,resolveOfflinePackStatus,OBSERVED_STATE_LABELS,TRANSFER_STATE_LABELS,type WorkspaceSession,type OfflinePackManifest} from '../../lib/coach-state';
 import {computeResourceGraph,prepareOfflinePack,CONTENT_VERSION,type ResourceLookup} from '../../lib/offline-pack';
 const root=(s:string)=>document.querySelector<HTMLElement>(s);const esc=(s:string)=>s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
 const grid=document.querySelector<HTMLElement>('.workspace-grid')!;
 const resourceLookup=JSON.parse(grid.dataset.resourceLookup??'{}') as ResourceLookup;
 function refs(selector:string,items:{title:string;href:string}[]){const el=root(selector);if(el)el.innerHTML=items.length?items.map(x=>`<a href="${esc(x.href)}">${esc(x.title)}</a>`).join(''):'<p class="empty">Nimic încă.</p>'}
 const OFFLINE_STATUS_LABEL:Record<string,string>={READY:'Disponibil pe teren',NOT_READY:'Indisponibil offline',UPDATE_AVAILABLE:'Actualizare disponibilă'};
 function packBadge(pack:OfflinePackManifest|undefined){
  if(!pack)return '';
  const status=resolveOfflinePackStatus(pack,CONTENT_VERSION);
  return `<span class="offline-badge offline-badge-${status.toLowerCase().replace(/_/g,'-')}">${esc(OFFLINE_STATUS_LABEL[status]??status)}</span>`;
 }
 function render(){
  const s=browserCoachStatePort.read();
  const onboarding=root('[data-onboarding]');if(onboarding)onboarding.hidden=s.profile.onboardingDone;
  refs('[data-saved]',s.saved);refs('[data-favorites]',s.favorites);refs('[data-recents]',s.recents);
  const sessions=root('[data-sessions]');
  if(sessions)sessions.innerHTML=s.sessions.length?s.sessions.map(x=>{
   const pack=findOfflinePackForSession(s,x.id);
   return `<article><h3>${esc(x.title)} ${packBadge(pack)}</h3><p>${x.duration} min · ${x.players} jucători · ${x.items.length} repere</p><div class="card-actions"><a href="/spatiul-meu/sedinta?id=${encodeURIComponent(x.id)}">Continuă</a><a href="/spatiul-meu/reflectie?ws=${encodeURIComponent(x.id)}">Reflectă</a><button type="button" data-prepare-offline="${esc(x.id)}">${pack?'Actualizează pentru teren':'Disponibil pe teren'}</button><button type="button" data-delete-session="${esc(x.id)}">Șterge</button></div><p class="offline-note" data-offline-note="${esc(x.id)}" aria-live="polite"></p></article>`;
  }).join(''):'<p class="empty">Nicio ședință proprie încă.</p>';
  const reflections=root('[data-reflections]');
  if(reflections)reflections.innerHTML=s.reflections.length?s.reflections.map(r=>{const date=new Date(r.createdAt).toLocaleDateString('ro-RO');const next=computeNextAction(r.observedState,r.transferState);return `<article><p class="refl-date">${esc(date)}</p><p>${esc(OBSERVED_STATE_LABELS[r.observedState])} · ${esc(TRANSFER_STATE_LABELS[r.transferState])}</p><p class="refl-next-mini">${esc(next)}</p><div class="card-actions"><a href="/spatiul-meu/reflectie?id=${encodeURIComponent(r.id)}">Editează</a><button type="button" data-delete-reflection="${esc(r.id)}">Șterge</button></div></article>`}).join(''):'<p class="empty">Nicio reflecție încă.</p>';
  const active=s.sessions.find(x=>x.id===s.activeSessionId);
  const unreflected=findUnreflectedSession(s);
  const latestReflection=s.reflections[0];
  const recent=s.recents[0];
  const link=document.querySelector<HTMLAnchorElement>('[data-continue-link]');
  const title=root('[data-continue-title]'),copy=root('[data-continue-copy]');
  if(active&&link&&title&&copy){title.textContent=active.title;copy.textContent=`${active.items.length} repere · actualizată local`;link.href=`/spatiul-meu/sedinta?id=${active.id}`;link.textContent='Continuă ședința →'}
  else if(unreflected&&link&&title&&copy){title.textContent=unreflected.title;copy.textContent='Ședință construită — reflectează pentru a continua.';link.href=`/spatiul-meu/reflectie?ws=${unreflected.id}`;link.textContent='Reflectă →'}
  else if(latestReflection&&link&&title&&copy){title.textContent='Ultima reflecție';copy.textContent=computeNextAction(latestReflection.observedState,latestReflection.transferState);link.href=`/spatiul-meu/reflectie?id=${latestReflection.id}`;link.textContent='Vezi reflecția →'}
  else if(recent&&link&&title&&copy){title.textContent=recent.title;copy.textContent='Ultimul reper canonic vizitat';link.href=recent.href;link.textContent='Continuă lectura →'}
 }
 document.querySelector<HTMLFormElement>('[data-onboarding] form')?.addEventListener('submit',e=>{e.preventDefault();const f=new FormData(e.currentTarget as HTMLFormElement);updateCoachState(s=>({...s,profile:{experience:String(f.get('experience')) as 'incepator'|'intermediar'|'experimentat',defaultPlayers:clampPlayers(f.get('players')),defaultDuration:Number(f.get('duration')) as 60|75,onboardingDone:true}}));render()});
 document.querySelector('.workspace-grid')?.addEventListener('click',async e=>{
  const target=e.target as HTMLElement;
  const sessionId=target.dataset.deleteSession;const reflectionId=target.dataset.deleteReflection;const prepareId=target.dataset.prepareOffline;
  if(sessionId&&confirm('Ștergi această ședință salvată local?')){deleteWorkspaceSession(sessionId);render();return}
  if(reflectionId&&confirm('Ștergi această reflecție?')){deleteReflection(reflectionId);render();return}
  if(prepareId){
   const state=browserCoachStatePort.read();
   const session=state.sessions.find(x=>x.id===prepareId) as WorkspaceSession|undefined;
   const noteEl=document.querySelector<HTMLElement>(`[data-offline-note="${prepareId}"]`);
   if(!session)return;
   if(!navigator.onLine){if(noteEl)noteEl.textContent='Ai nevoie de conexiune pentru a pregăti prima dată o ședință pentru teren.';return}
   (target as HTMLButtonElement).disabled=true;
   if(noteEl)noteEl.textContent='Se pregătesc resursele pentru teren…';
   const graph=computeResourceGraph(session,resourceLookup);
   const result=await prepareOfflinePack(graph);
   if(graph.unresolvedRefs.length||!result.ok){
    saveOfflinePack({workspaceSessionId:session.id,routes:result.cachedRoutes,mediaRefs:graph.mediaRefs,canonicalRefs:graph.canonicalRefs,contentVersion:CONTENT_VERSION,status:'NOT_READY'});
    if(noteEl)noteEl.textContent='Nu am putut pregăti toate resursele pentru teren. Verifică conexiunea și încearcă din nou.';
   } else {
    saveOfflinePack({workspaceSessionId:session.id,routes:result.cachedRoutes,mediaRefs:graph.mediaRefs,canonicalRefs:graph.canonicalRefs,contentVersion:CONTENT_VERSION,status:'READY'});
    if(noteEl)noteEl.textContent='Ședința pregătită pentru teren rămâne disponibilă fără conexiune.';
   }
   (target as HTMLButtonElement).disabled=false;
   render();
  }
 });
 function updateConnStatus(){
  const el=root('[data-conn-status]');if(!el)return;
  if(navigator.onLine){el.hidden=true}
  else{el.hidden=false;el.textContent='Offline — ședințele pregătite pentru teren rămân disponibile.'}
 }
 window.addEventListener('online',updateConnStatus);
 window.addEventListener('offline',updateConnStatus);
 window.addEventListener('manualfc:state',render);
 updateConnStatus();
 render();
</script>
<style>
 .workspace-head{padding:clamp(2rem,6vw,5rem) 0;max-width:760px}.conn-status{padding:.6rem 1rem;background:#3a2f12;color:#fff;font-weight:750;font-size:.85rem;border-radius:8px;margin-bottom:1rem}.onboarding{padding:1.5rem;background:#f4f4f1;border-left:5px solid var(--color-brand-gold)}.onboarding form{display:grid;grid-template-columns:repeat(3,1fr) auto;gap:.75rem;align-items:end}.onboarding label{font-weight:800}.onboarding input,.onboarding select,.onboarding button{display:block;width:100%;min-height:46px;margin-top:.35rem}.continue{display:flex;justify-content:space-between;gap:2rem;align-items:center;padding:1.5rem;background:var(--color-bg-brand);color:#fff}.continue h2{color:#fff}.continue p{color:#fff}.continue .eyebrow{color:var(--color-brand-gold)}.continue a,.primary{display:inline-flex;min-height:48px;align-items:center;padding:0 1rem;background:var(--color-brand-gold);color:var(--color-bg-brand);font-weight:850;text-decoration:none}.workspace-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1rem}.workspace-grid>section{padding:1.5rem;background:#fff;border:1px solid var(--color-border)}.ref-list{display:grid}.ref-list :global(a){padding:.8rem 0;border-top:1px solid var(--color-border);font-weight:750}.empty{color:var(--color-text-muted)}:global(.workspace-grid [data-sessions] article),:global(.workspace-grid [data-reflections] article){padding:1rem 0;border-top:1px solid var(--color-border)}:global(.workspace-grid .card-actions){display:flex;flex-wrap:wrap;gap:.75rem;margin-top:.5rem}:global(.workspace-grid .card-actions a),:global(.workspace-grid .card-actions button){min-height:44px;display:inline-flex;align-items:center;padding:0 .75rem;font:750 .85rem inherit;border:1px solid var(--color-border);background:#fff;cursor:pointer}:global(.workspace-grid .refl-next-mini){font-size:.85rem;color:var(--color-text-secondary)}:global(.workspace-grid .refl-date){font-size:.75rem;color:var(--color-text-muted);font-weight:750}:global(.workspace-grid .offline-badge){display:inline-block;margin-left:.5rem;font-size:.65rem;font-weight:850;text-transform:uppercase;letter-spacing:.04em;padding:.2rem .5rem;border-radius:999px;vertical-align:middle}:global(.workspace-grid .offline-badge-ready){background:#edf3f0;color:#17774b}:global(.workspace-grid .offline-badge-not-ready){background:#f5e3e0;color:#a33b25}:global(.workspace-grid .offline-badge-update-available){background:#fdf1d9;color:#8a5b0a}:global(.workspace-grid .offline-note){margin-top:.4rem;font-size:.78rem;color:var(--color-text-muted)}@media(max-width:760px){.onboarding form,.workspace-grid{grid-template-columns:1fr}.continue{align-items:flex-start;flex-direction:column}}
</style>
