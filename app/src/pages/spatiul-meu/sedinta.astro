---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumb from '../../components/Breadcrumb.astro'; import {getDiscoveryIndex} from '../../lib/discovery-index'; import {getMediaForExercise} from '../../lib/media-registry';
const hasMotionMedia=(id:string)=>getMediaForExercise(id).some(m=>(m.media_type==='TACTICAL_LOOP'||m.media_type==='EXERCISE_ANIMATION')&&m.status==='AVAILABLE');
const exercises=getDiscoveryIndex().filter(x=>x.type==='EXERCIȚIU').map(x=>({id:x.id,title:x.title,href:x.href,minutes:x.minutes||15,hasLoop:hasMotionMedia(x.id)}));
const problems=getDiscoveryIndex().filter(x=>x.type==='PROBLEMĂ').map(x=>({id:x.id,title:x.title}));
const canonicalSessions=getDiscoveryIndex().filter(x=>x.type==='ȘEDINȚĂ').map(x=>({id:x.id,title:x.title,href:x.href,minutes:x.minutes||60}));
---
<BaseLayout title="Constructor de ședință" description="Construiește local o ședință U11 din repere canonice ManualFC.">
 <Breadcrumb items={[{label:'Spațiul meu',href:'/spatiul-meu'},{label:'Constructor de ședință'}]}/><header class="builder-head"><p class="eyebrow">SESSION WORKSPACE · REFERINȚE CANONICE</p><h1>Construiește ședința</h1><p>Configurația ta păstrează numai ID-uri, ordine, durate și notițe. Conținutul pedagogic rămâne în sursa canonică.</p></header>
 <div class="builder"><form data-builder data-exercises={JSON.stringify(exercises)} data-canonical-sessions={JSON.stringify(canonicalSessions)}><section><h2>Context</h2><label>Titlu<input name="title" maxlength="80" value="Ședința mea"/></label><label>Problema urmărită<select name="problem"><option value="">Alege ulterior</option>{problems.map(x=><option value={x.id}>{x.title}</option>)}</select></label><div class="three"><label>Durată<select name="duration"><option value="75">75 min</option><option value="60">60 min</option></select></label><label>Jucători<input name="players" type="number" min="8" max="18" value="12"/></label><label>Antrenori<select name="coaches"><option value="1">1</option><option value="2">2</option></select></label></div></section><section><h2>Repere canonice</h2><label>Adaugă exercițiu<select data-catalog><option value="">Selectează</option>{exercises.map(x=><option value={x.id}>{x.id} · {x.title}</option>)}</select></label><button type="button" data-add>Adaugă</button><label>Adaugă ședință canonică (include Mod Teren pentru pregătirea pe teren)<select data-session-catalog><option value="">Selectează</option>{canonicalSessions.map(x=><option value={x.id}>{x.id} · {x.title}</option>)}</select></label><button type="button" data-add-session>Adaugă ședință</button><div data-items></div><p data-total aria-live="polite"></p></section><section><h2>Notițe de lucru</h2><label>Fără nume sau date despre copii<textarea name="notes" rows="5" placeholder="Ex. pregătesc două zone; verific transferul în jocul final."></textarea></label></section><button class="save">Salvează local</button><p data-status aria-live="polite"></p></form><aside><h2>Rezumat operațional</h2><dl><div><dt>Materiale</dt><dd>Verifică fișele canonice ale exercițiilor selectate.</dd></div><div><dt>Spațiu</dt><dd>Deschide fiecare reper pentru dimensiuni și adaptarea la efectiv.</dd></div><div><dt>Confidențialitate</dt><dd>Nu introduce nume, sănătate, contact sau alte date despre copii.</dd></div></dl><a href="/spatiul-meu">← Spațiul meu</a></aside></div>
</BaseLayout>
<script>
 import {browserCoachStatePort,makeSession,clampPlayers} from '../../lib/coach-state';
 const form=document.querySelector<HTMLFormElement>('[data-builder]')!,catalog=document.querySelector<HTMLSelectElement>('[data-catalog]')!,sessionCatalog=document.querySelector<HTMLSelectElement>('[data-session-catalog]')!,itemsEl=document.querySelector<HTMLElement>('[data-items]')!,totalEl=document.querySelector<HTMLElement>('[data-total]')!,statusEl=document.querySelector<HTMLElement>('[data-status]')!;const exercises=JSON.parse(form.dataset.exercises??'[]') as {id:string;title:string;href:string;minutes:number;hasLoop:boolean}[];const canonicalSessions=JSON.parse(form.dataset.canonicalSessions??'[]') as {id:string;title:string;href:string;minutes:number}[];let state=browserCoachStatePort.read();const wanted=new URLSearchParams(location.search).get('id');let session=state.sessions.find(x=>x.id===wanted)||state.sessions.find(x=>x.id===state.activeSessionId)||makeSession(state);const byId=new Map(exercises.map(x=>[x.id,x]));const sesById=new Map(canonicalSessions.map(x=>[x.id,x]));const catalogFor=(kind:string)=>kind==='session'?sesById:byId;session={...session,items:session.items.filter(x=>catalogFor(x.ref.kind).has(x.ref.id)).map(x=>({...x,ref:{...x.ref,...catalogFor(x.ref.kind).get(x.ref.id)!}}))};
 function syncForm(){(form.elements.namedItem('title') as HTMLInputElement).value=session.title;(form.elements.namedItem('problem') as HTMLSelectElement).value=session.problemId||'';(form.elements.namedItem('duration') as HTMLSelectElement).value=String(session.duration);(form.elements.namedItem('players') as HTMLInputElement).value=String(session.players);(form.elements.namedItem('coaches') as HTMLSelectElement).value=String(session.coaches);(form.elements.namedItem('notes') as HTMLTextAreaElement).value=session.notes}
 function render(){itemsEl.innerHTML=session.items.length?session.items.map((x,i)=>`<article data-index="${i}"><div><strong>${x.ref.id} · ${x.ref.title}</strong>${byId.get(x.ref.id)?.hasLoop?'<span class="media-badge" title="Are buclă tactică sau animație">▶ mișcare</span>':''}<a href="${x.ref.href}">Deschide fișa</a></div><label>Minute<input data-minutes type="number" min="5" max="90" value="${x.minutes}"></label><div><button type="button" data-up aria-label="Mută în sus">↑</button><button type="button" data-down aria-label="Mută în jos">↓</button><button type="button" data-remove>Elimină</button></div></article>`).join(''):'<p>Nu ai adăugat încă repere.</p>';const total=session.items.reduce((n,x)=>n+x.minutes,0);totalEl.textContent=`Total planificat: ${total} din ${session.duration} minute${total>session.duration?' · depășește durata aleasă':''}`;itemsEl.querySelectorAll<HTMLElement>('article').forEach(el=>{const i=Number(el.dataset.index);el.querySelector('[data-up]')?.addEventListener('click',()=>move(i,-1));el.querySelector('[data-down]')?.addEventListener('click',()=>move(i,1));el.querySelector('[data-remove]')?.addEventListener('click',()=>{session.items.splice(i,1);render()});el.querySelector<HTMLInputElement>('[data-minutes]')?.addEventListener('change',e=>{session.items[i].minutes=Math.max(5,Number((e.target as HTMLInputElement).value));render()})})}
 function move(i:number,d:number){const j=i+d;if(j<0||j>=session.items.length)return;[session.items[i],session.items[j]]=[session.items[j],session.items[i]];render()}
 document.querySelector('[data-add]')?.addEventListener('click',()=>{const x=byId.get(catalog.value);if(x&&!session.items.some(y=>y.ref.id===x.id)){session.items.push({ref:{id:x.id,kind:'exercise',title:x.title,href:x.href},minutes:x.minutes});render()}});
 document.querySelector('[data-add-session]')?.addEventListener('click',()=>{const x=sesById.get(sessionCatalog.value);if(x&&!session.items.some(y=>y.ref.id===x.id)){session.items.push({ref:{id:x.id,kind:'session',title:x.title,href:x.href},minutes:x.minutes});render()}});form.addEventListener('submit',e=>{e.preventDefault();const f=new FormData(form),duration=Number(f.get('duration')) as 60|75,total=session.items.reduce((n,x)=>n+x.minutes,0);if(!session.items.length){statusEl.textContent='Adaugă cel puțin un reper canonic înainte de salvare.';return}if(total>duration){statusEl.textContent=`Planul are ${total} minute și depășește durata de ${duration}. Ajustează blocurile.`;return}session={...session,title:String(f.get('title')).trim()||'Ședința mea',problemId:String(f.get('problem'))||undefined,duration,players:clampPlayers(f.get('players')),coaches:Number(f.get('coaches')) as 1|2,notes:String(f.get('notes')),updatedAt:new Date().toISOString()};state=browserCoachStatePort.read();browserCoachStatePort.write({...state,sessions:[session,...state.sessions.filter(x=>x.id!==session.id)],activeSessionId:session.id});statusEl.textContent='Ședința a fost salvată în acest browser.';history.replaceState({},'',`?id=${encodeURIComponent(session.id)}`);render()});syncForm();render();
</script>
<style>
 .builder-head{padding:clamp(2rem,5vw,4rem) 0;max-width:800px}.builder{display:grid;grid-template-columns:minmax(0,2fr) minmax(260px,1fr);gap:1.5rem}.builder form>section,.builder aside{padding:1.5rem;margin-bottom:1rem;background:#fff;border:1px solid var(--color-border)}label{display:block;font-weight:800;margin:.75rem 0}input,select,textarea{display:block;width:100%;min-height:46px;margin-top:.35rem;padding:.5rem;font:inherit}.three{display:grid;grid-template-columns:repeat(3,1fr);gap:.75rem}[data-add],[data-add-session],.save{min-height:44px;padding:.5rem .85rem}:global(.builder [data-items] button){min-height:44px;padding:.5rem .85rem}:global(.builder [data-items] article){display:grid;grid-template-columns:1fr 90px auto;gap:.75rem;align-items:center;padding:1rem 0;border-top:1px solid var(--color-border)}:global(.builder [data-items] article a){display:block;font-size:.8rem}:global(.builder [data-items] input){min-height:46px;width:100%;padding:.5rem;font:inherit}.save{background:var(--color-bg-brand);color:#fff;border:0;font-weight:850}.builder aside{align-self:start;position:sticky;top:1rem}.builder dl>div{padding:1rem 0;border-top:1px solid var(--color-border)}dt{font-weight:850}dd{margin:.35rem 0;color:var(--color-text-muted)}@media(max-width:800px){.builder{grid-template-columns:1fr}.builder aside{position:static}}@media(max-width:560px){.three{grid-template-columns:1fr}:global(.builder [data-items] article){grid-template-columns:1fr}}:global(.builder [data-items] .media-badge){display:inline-block;margin-left:.5rem;font-size:.7rem;font-weight:800;padding:.15rem .5rem;border-radius:999px;background:#edf3f0;color:#17774b;vertical-align:middle}
</style>
