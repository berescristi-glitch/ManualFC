---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FieldCard from '../../components/FieldCard.astro';
import { getGoldStandardExercises } from '../../lib/content-bridge';

const exercises = getGoldStandardExercises().filter((ex) => ex.theme === 'sprijin-si-unghi-de-pasa');
---
<BaseLayout
  title="Fișe de teren — Modul complet"
  description="O fișă pe ecran, per exercițiu: format, spațiu, timp, materiale, diagramă, mesaj exact, ce urmărești, regresie și progresie — fără raționale sau dovezi, doar ce ai nevoie lângă teren."
>
  <div class="fise-page">
    <Breadcrumb items={[{ label: 'Modul complet', href: '/gold-standard' }, { label: 'Fișe de teren' }]} />
    <p class="eyebrow">GOLD STANDARD · LÂNGĂ TEREN</p>
    <h1>Fișe de teren</h1>
    <p class="intro">
      O fișă pe ecran per exercițiu — ce iei cu tine lângă teren, nu manualul complet. Pentru raționale, cele 7
      dimensiuni de justificare și dovezi, vezi pagina completă a fiecărui exercițiu (link la finalul fiecărei fișe).
      La imprimare, fiecare fișă începe pe o pagină nouă.
    </p>
    <div class="cards">
      {exercises.map((ex) => <FieldCard exercise={ex} />)}
    </div>
  </div>
</BaseLayout>

<style>
  .fise-page { max-width: var(--width-content); margin: 0 auto; padding: var(--space-20) var(--space-6); }
  h1 { max-width: 20ch; }
  .intro { max-width: 68ch; font-size: 1.05rem; color: var(--color-text-muted); }
  .cards { display: grid; gap: var(--space-10); margin-top: var(--space-12); }
  @media print { .fise-page { padding: 0; max-width: none; } .intro, .eyebrow, h1, nav { display: none; } .cards { gap: 0; } }
</style>
