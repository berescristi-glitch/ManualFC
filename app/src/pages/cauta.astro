---
import BaseLayout from '../layouts/BaseLayout.astro'; import Breadcrumb from '../components/Breadcrumb.astro'; import {getDiscoveryIndex} from '../lib/discovery-index';
const items=getDiscoveryIndex(); const types=[...new Set(items.map(x=>x.type))];
---
<BaseLayout title="Caută în ManualFC" description="Căutare lexicală și filtre deterministe în probleme, principii, exerciții, ședințe, evaluări și capitole U11.">
  <Breadcrumb items={[{label:'Acasă',href:'/'},{label:'Caută'}]}/><section class="search-head"><p class="eyebrow">DISCOVERY · DETERMINIST</p><h1>Ce vrei să rezolvi?</h1><label for="q">Caută după observație, principiu sau activitate</label><input id="q" type="search" placeholder="Ex. 12 jucători, 20 minute, scanare…"/><p>Căutarea nu inventează recomandări. Potrivirea vine numai din metadata și conținut canonic.</p></section>
  <section class="controls" aria-label="Filtre de căutare"><label>Tip<select id="type"><option value="all">Toate</option>{types.map(t=><option>{t}</option>)}</select></label><label>Efectiv<select id="players"><option value="all">Oricare</option><option value="12">12 jucători</option><option value="18">18 jucători</option></select></label><label>Timp<select id="time"><option value="all">Oricât</option><option value="20">Maximum 20 min</option><option value="60">Maximum 60 min</option><option value="75">Maximum 75 min</option></select></label><label>Dovezi<select id="evidence"><option value="all">Toate</option><option value="EVIDENCE">Cu dovezi legate</option><option value="FIELD">Necesită teren</option></select></label><button id="reset">Resetează</button></section>
  <p id="count" aria-live="polite">{items.length} rezultate</p><section id="results" class="results">{items.map(item=><article data-item data-type={item.type} data-search={item.searchText} data-title={item.title.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase()} data-summary={item.summary.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase()} data-players-min={item.playersMin||''} data-players-max={item.playersMax||''} data-minutes={item.minutes||''} data-evidence={item.evidence}><span>{item.type}{item.media?' · VIZUAL':''}</span><h2><a href={item.href}>{item.title}</a></h2><p>{item.summary}</p><small data-why>Conținut canonic disponibil</small></article>)}</section>
  <section id="empty" hidden><h2>Nu am găsit o potrivire canonică.</h2><p>Încearcă „primește”, „spațiu”, „după pierdere” sau elimină filtrele. Nu completăm golul cu un răspuns inventat.</p><a href="/rezolva-pe-teren">Vezi toate observațiile</a></section>
</BaseLayout>
<script>
 const q=document.querySelector<HTMLInputElement>('#q')!,type=document.querySelector<HTMLSelectElement>('#type')!,players=document.querySelector<HTMLSelectElement>('#players')!,time=document.querySelector<HTMLSelectElement>('#time')!,evidence=document.querySelector<HTMLSelectElement>('#evidence')!,cards=[...document.querySelectorAll<HTMLElement>('[data-item]')],count=document.querySelector('#count')!,empty=document.querySelector<HTMLElement>('#empty')!;const norm=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
 function run(){const terms=norm(q.value).trim().split(/\s+/).filter(Boolean);let n=0;cards.forEach(c=>{let score=terms.length?terms.reduce((v,t)=>v+(c.dataset.title?.includes(t)?5:0)+(c.dataset.summary?.includes(t)?3:0)+(c.dataset.search?.includes(t)?1:0),0):1;const p=Number(players.value),min=Number(c.dataset.playersMin),max=Number(c.dataset.playersMax),m=Number(c.dataset.minutes);const playerOk=players.value==='all'||(min>0&&p>=min&&p<=max);const timeOk=time.value==='all'||(m>0&&m<=Number(time.value));const ev=evidence.value==='all'||(evidence.value==='EVIDENCE'&&c.dataset.evidence!=='NEEDS_FIELD_VALIDATION')||(evidence.value==='FIELD'&&c.dataset.evidence==='NEEDS_FIELD_VALIDATION');const show=score>0&&(type.value==='all'||c.dataset.type===type.value)&&playerOk&&timeOk&&ev;c.hidden=!show;if(show){n++;const why=c.querySelector('[data-why]');if(why)why.textContent=terms.some(t=>c.dataset.title?.includes(t))?'De ce apare: potrivire în titlu':terms.some(t=>c.dataset.summary?.includes(t))?'De ce apare: potrivire în obiectiv sau observație':'De ce apare: potrivire în conținutul canonic'}});count.textContent=`${n} ${n===1?'rezultat':'rezultate'}`;empty.hidden=n!==0}
 [q,type,players,time,evidence].forEach(x=>x.addEventListener(x===q?'input':'change',run));document.querySelector('#reset')?.addEventListener('click',()=>{q.value='';type.value=players.value=time.value=evidence.value='all';run()});
</script>
<style>
 .search-head{padding:clamp(2rem,6vw,5rem) 0}.search-head label{display:block;font-weight:800;margin:2rem 0 .5rem}.search-head input{width:100%;min-height:58px;padding:0 1rem;font:inherit;border:2px solid var(--color-bg-brand);border-radius:8px}.controls{display:grid;grid-template-columns:repeat(5,1fr);gap:.75rem;padding:1rem;background:#f4f4f1}.controls label{font-weight:800;font-size:.8rem}.controls select,.controls button{display:block;width:100%;min-height:46px;margin-top:.35rem;border:1px solid var(--color-border);background:#fff}.results{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.results article{padding:1.4rem;border:1px solid var(--color-border);background:#fff}.results span,.results small{font:700 .7rem var(--font-family-mono);color:var(--color-text-muted)}.results h2{font-size:1.35rem}.results small{display:block;border-top:1px solid var(--color-border);padding-top:.7rem}#empty{padding:3rem;background:#f4f4f1}@media(max-width:820px){.controls{grid-template-columns:1fr 1fr}.results{grid-template-columns:1fr}}@media(max-width:430px){.controls{grid-template-columns:1fr}.search-head{padding-top:2rem}}
</style>
