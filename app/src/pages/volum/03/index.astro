---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const chapters = [
  ['CH-0301', 'Limbaj scurt și informație relevantă', '/volum/03/ch-0301'],
  ['CH-0302', 'Întrebări, feedback și verificarea înțelegerii', '/volum/03/ch-0302'],
  ['CH-0303', 'Emoții, greșeală și climat de siguranță', '/volum/03/ch-0303'],
  ['CH-0304', 'Disciplina fără umilire', '/volum/03/ch-0304'],
  ['CH-0305', 'Comunicarea antrenorului în timpul meciului', '/volum/03/ch-0305'],
  ['CH-0306', 'Conversații individuale și echitate', '/volum/03/ch-0306'],
  ['CH-0307', 'Feedback specific și demonstrație fără impunere', '/volum/03/ch-0307'],
  ['CH-0308', 'Identitatea antrenorului: dincolo de tactică', '/volum/03/ch-0308'],
  ['CH-0309', 'Reflecția antrenorului: ce am observat despre propria intervenție', '/volum/03/ch-0309'],
  ['CH-0310', 'Dezvoltarea profesională a antrenorului: ce chiar funcționează', '/volum/03/ch-0310']
];
---

<BaseLayout title="Volumul 03 — ManualFC" description="Comunicarea antrenorului, psihologia aplicată și climatul de învățare la 10–11 ani">
  <div class="volume-index">
    <p class="eyebrow">VOLUMUL 03 · 10 CAPITOLE</p>
    <h1>Comunicarea antrenorului, psihologia aplicată și climatul de învățare</h1>
    <p class="intro">Traseul de formare a antrenorului ca pedagog U11: de la compresia limbajului vorbit și întrebări ghidate la gestionarea erorilor, disciplina respectuoasă, susținerea fără dirijare în timpul meciului și echitatea atenției individuale.</p>
    <ol>
      {chapters.map(([id, title, href]) => <li><a href={href}><span>{id}</span><strong>{title}</strong></a></li>)}
    </ol>
    <nav class="volume-nav" aria-label="Navigare volume"><a href="/volum/02">← Volumul 02 — Fundația tactică și decizia în joc</a><a href="/volum/04">Volumul 04 — Metodologia practică de predare →</a></nav>
    <p class="see-also">Vezi și: <a href="/principii">toate principiile</a> · <a href="/gold-standard">Gold Standard — sprijinul și unghiul de pasă</a></p>
  </div>
</BaseLayout>

<style>
  .volume-index{max-width:var(--width-content);margin:0 auto;padding:var(--space-20) var(--space-6)}
  h1{max-width:min(20ch, 100%);overflow-wrap:break-word}.intro{max-width:68ch;font-size:1.15rem}ol{list-style:none;padding:0;margin-top:var(--space-12)}
  li{border-top:1px solid var(--color-border)}a{display:grid;grid-template-columns:8rem 1fr;gap:var(--space-4);padding:var(--space-6) 0;text-decoration:none;align-items:baseline}a span{font-family:var(--font-family-mono);color:var(--color-text-accent)}
  @media(max-width:600px){a{grid-template-columns:1fr;gap:.3rem}}
  .volume-nav{margin-top:var(--space-12);padding-top:var(--space-6);border-top:2px solid var(--color-border);display:flex;justify-content:space-between;gap:var(--space-4);flex-wrap:wrap}.volume-nav a{font-weight:750;text-decoration:none;color:var(--color-text-accent)}
  .see-also{margin-top:var(--space-4);font-size:.9rem;color:var(--color-text-muted)}.see-also a{color:var(--color-text-accent)}
</style>
