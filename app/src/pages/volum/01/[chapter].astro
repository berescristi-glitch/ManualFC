---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Chapter01 from '../../../../../content/volume-01/chapter-01.mdx';
import Chapter02 from '../../../../../content/volume-01/chapter-02.mdx';
import Chapter03 from '../../../../../content/volume-01/chapter-03.mdx';
import Chapter04 from '../../../../../content/volume-01/chapter-04.mdx';
import Chapter05 from '../../../../../content/volume-01/chapter-05.mdx';
import Chapter06 from '../../../../../content/volume-01/chapter-06.mdx';
import Chapter07 from '../../../../../content/volume-01/chapter-07.mdx';
import Chapter08 from '../../../../../content/volume-01/chapter-08.mdx';
import Chapter09 from '../../../../../content/volume-01/chapter-09.mdx';
import Chapter10 from '../../../../../content/volume-01/chapter-10.mdx';

const chapters = {
  'ch-0101': { title: 'Profilul integrat de dezvoltare', component: Chapter01 },
  'ch-0102': { title: 'Percepție, orientare și atenție în joc', component: Chapter02 },
  'ch-0103': { title: 'Decizia autonomă și rolul erorii', component: Chapter03 },
  'ch-0104': { title: 'Formularea mesajului pedagogic', component: Chapter04 },
  'ch-0105': { title: 'Evaluarea înțelegerii și transferul în joc', component: Chapter05 },
  'ch-0106': { title: 'Emoțiile copilului: frustrare, anxietate competițională și rușine', component: Chapter06 },
  'ch-0107': { title: 'Relația pedagogică: cald și structurat, nu unul în locul celuilalt', component: Chapter07 },
  'ch-0108': { title: 'Comunicarea de zi cu zi: claritate, ton și verificarea reală a înțelegerii', component: Chapter08 },
  'ch-0109': { title: 'Părinții: sprijin, implicare și granițele rolului de antrenor', component: Chapter09 },
  'ch-0110': { title: 'Cât poate reflecta singur copilul: limitele auto-monitorizării la 10–11 ani', component: Chapter10 }
} as const;

export function getStaticPaths() {
  return ['ch-0101', 'ch-0102', 'ch-0103', 'ch-0104', 'ch-0105', 'ch-0106', 'ch-0107', 'ch-0108', 'ch-0109', 'ch-0110'].map(chapter => ({ params: { chapter } }));
}

const slug = Astro.params.chapter as keyof typeof chapters;
const entry = chapters[slug];
if (!entry) throw new Error(`[FAIL_CLOSED] Capitol VOLUME-01 necunoscut: ${slug}`);
const Content = entry.component;
---

<BaseLayout title={`${entry.title} — ManualFC`} description={`Capitolul ${slug.toUpperCase()} din VOLUMUL 01`}>
  <article class="chapter-shell">
    <nav aria-label="Volumul 01"><a href="/volum/01">← Cuprins Volumul 01</a></nav>
    <article class="chapter-content"><Content /></article>
  </article>
</BaseLayout>

<style>
  .chapter-shell{max-width:var(--width-content);margin:0 auto;padding:var(--space-12) var(--space-6) var(--space-20)}
  nav{margin-bottom:var(--space-10)}nav a{font-weight:750}.chapter-content :global(h1){max-width:min(18ch, 100%);overflow-wrap:break-word}.chapter-content :global(h2){margin-top:var(--space-12)}.chapter-content :global(h3){margin-top:var(--space-8)}.chapter-content :global(p),.chapter-content :global(li){max-width:72ch}.chapter-content :global(code){overflow-wrap:anywhere}
</style>
