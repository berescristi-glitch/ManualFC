---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Chapter01 from '../../../../../content/volume-02/chapter-01.mdx';
import Chapter02 from '../../../../../content/volume-02/chapter-02.mdx';
import Chapter03 from '../../../../../content/volume-02/chapter-03.mdx';
import Chapter04 from '../../../../../content/volume-02/chapter-04.mdx';
import Chapter05 from '../../../../../content/volume-02/chapter-05.mdx';
import Chapter06 from '../../../../../content/volume-02/chapter-06.mdx';
import Chapter07 from '../../../../../content/volume-02/chapter-07.mdx';
import Chapter08 from '../../../../../content/volume-02/chapter-08.mdx';

const chapters = {
  'ch-0201': { title: 'Jocul ca sistem de probleme', component: Chapter01 },
  'ch-0202': { title: 'Spațiu și unghiuri', component: Chapter02 },
  'ch-0203': { title: 'Progresie și sprijin', component: Chapter03 },
  'ch-0204': { title: 'Protejarea centrului', component: Chapter04 },
  'ch-0205': { title: 'Presiune și acoperire', component: Chapter05 },
  'ch-0206': { title: 'Tranziția la pierderea mingii', component: Chapter06 },
  'ch-0207': { title: 'Tranziția la câștigarea mingii', component: Chapter07 },
  'ch-0208': { title: 'Superioritate, egalitate și inferioritate numerică', component: Chapter08 }
} as const;

export function getStaticPaths() {
  return ['ch-0201', 'ch-0202', 'ch-0203', 'ch-0204', 'ch-0205', 'ch-0206', 'ch-0207', 'ch-0208'].map(chapter => ({ params: { chapter } }));
}

const slug = Astro.params.chapter as keyof typeof chapters;
const entry = chapters[slug];
if (!entry) throw new Error(`[FAIL_CLOSED] Capitol VOLUME-02 necunoscut: ${slug}`);
const Content = entry.component;
---

<BaseLayout title={`${entry.title} — ManualFC`} description={`Capitolul ${slug.toUpperCase()} din VOLUMUL 02`}>
  <article class="chapter-shell">
    <nav aria-label="Volumul 02"><a href="/volum/02">← Cuprins Volumul 02</a></nav>
    <article class="chapter-content"><Content /></article>
  </article>
</BaseLayout>

<style>
  .chapter-shell{max-width:var(--width-content);margin:0 auto;padding:var(--space-12) var(--space-6) var(--space-20)}
  nav{margin-bottom:var(--space-10)}nav a{font-weight:750}.chapter-content :global(h1){max-width:min(18ch, 100%);overflow-wrap:break-word}.chapter-content :global(h2){margin-top:var(--space-12)}.chapter-content :global(h3){margin-top:var(--space-8)}.chapter-content :global(p),.chapter-content :global(li){max-width:72ch}.chapter-content :global(code){overflow-wrap:anywhere}
</style>
