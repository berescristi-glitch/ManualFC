---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const chapters = [
  ['CH-0201', 'Jocul ca sistem de probleme', '/volum/02/ch-0201'],
  ['CH-0202', 'Spațiu și unghiuri', '/volum/02/ch-0202'],
  ['CH-0203', 'Progresie și sprijin', '/volum/02/ch-0203'],
  ['CH-0204', 'Protejarea centrului', '/volum/02/ch-0204'],
  ['CH-0205', 'Presiune și acoperire', '/volum/02/ch-0205'],
  ['CH-0206', 'Tranziția la pierderea mingii', '/volum/02/ch-0206'],
  ['CH-0207', 'Tranziția la câștigarea mingii', '/volum/02/ch-0207'],
  ['CH-0208', 'Superioritate, egalitate și inferioritate numerică', '/volum/02/ch-0208']
];
---

<BaseLayout title="Volumul 02 — ManualFC" description="Fundația tactică și decizia în joc la 10–11 ani">
  <div class="volume-index">
    <p class="eyebrow">VOLUMUL 02 · 8 CAPITOLE</p>
    <h1>Fundația tactică și decizia în joc</h1>
    <p class="intro">Traseul de formare tactică U11: de la identificarea problemelor jocului la soluții în posesie, organizare defensivă, tranziții și gestionarea situațiilor numerice. Capitolele construiesc progresiv, fără mecanizare sau coregrafii rigide.</p>
    <ol>
      {chapters.map(([id, title, href]) => <li><a href={href}><span>{id}</span><strong>{title}</strong></a></li>)}
    </ol>
    <nav class="volume-nav" aria-label="Navigare volume"><a href="/volum/01">← Volumul 01 — Copilul înaintea fotbalistului</a><a href="/volum/03">Volumul 03 — Comunicarea antrenorului →</a></nav>
    <p class="see-also">Vezi și: <a href="/principii">toate principiile</a> · <a href="/gold-standard">Gold Standard — sprijinul și unghiul de pasă</a> (folosește direct principiile din acest volum)</p>
  </div>
</BaseLayout>

<style>
  .volume-index{max-width:var(--width-content);margin:0 auto;padding:var(--space-20) var(--space-6)}
  h1{max-width:14ch}.intro{max-width:68ch;font-size:1.15rem}ol{list-style:none;padding:0;margin-top:var(--space-12)}
  li{border-top:1px solid var(--color-border)}a{display:grid;grid-template-columns:8rem 1fr;gap:var(--space-4);padding:var(--space-6) 0;text-decoration:none;align-items:baseline}a span{font-family:var(--font-family-mono);color:var(--color-text-accent)}
  @media(max-width:600px){a{grid-template-columns:1fr;gap:.3rem}}
  .volume-nav{margin-top:var(--space-12);padding-top:var(--space-6);border-top:2px solid var(--color-border);display:flex;justify-content:space-between;gap:var(--space-4);flex-wrap:wrap}.volume-nav a{font-weight:750;text-decoration:none;color:var(--color-text-accent)}
  .see-also{margin-top:var(--space-4);font-size:.9rem;color:var(--color-text-muted)}.see-also a{color:var(--color-text-accent)}
</style>
